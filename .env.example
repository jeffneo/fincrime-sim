# Copy to .env and adjust. .env is gitignored.

NEO4J_PASSWORD=fincrimefincrime
NEO4J_IMAGE=neo4j:2026.07-enterprise

# Sized for the `mvp` preset (~30M transaction nodes). Drop to 4G/2G if you are
# only iterating on the `dev` preset.
NEO4J_HEAP=8G
NEO4J_PAGECACHE=4G

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NES_PORT=8080

# Target Aura instance for `make aura-push`. The mvp graph does not run
# interactively on a laptop-sized container, so the demo target is a managed
# instance with enough page cache to hold the store (PERFORMANCE-NOTES.md).
# The dump is uploaded with --overwrite-destination: whatever the instance
# holds is replaced.
# AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# AURA_USERNAME=neo4j
# AURA_PASSWORD=

# Licenses are referenced by path, never copied into an image or committed
# (both are gitignored). gds.license and nes.license already sit at the repo
# root, which is where compose looks by default - override only if yours move.
# GDS_LICENSE_PATH=./gds.license
# NES_LICENSE_PATH=./nes.license
